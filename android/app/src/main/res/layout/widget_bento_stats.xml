<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bento_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Label Header -->
    <RelativeLayout
        android:id="@+id/bento_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/label_momentum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="VELOCITY"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#8B95A5"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_speedometer" />
    </RelativeLayout>

    <!-- Circular Progress Gauge in Center -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bento_header"
        android:layout_above="@+id/bento_status_pill"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/bento_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bento_stats_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="84%"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/bento_velocity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPTIMAL"
                android:fontFamily="sans-serif-condensed"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Status Pill Footer -->
    <LinearLayout
        android:id="@+id/bento_status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/widget_streak_badge_bg"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_dot_green" />

        <TextView
            android:id="@+id/bento_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS: NOMINAL"
            android:fontFamily="sans-serif-medium"
            android:textColor="#CBD5E1"
            android:letterSpacing="0.05"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
