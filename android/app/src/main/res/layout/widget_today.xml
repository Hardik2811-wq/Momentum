<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: TODAY FOCUS, Streak Badge, Plus Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/header_left_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/header_right_container"
            android:layout_marginEnd="4dp"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/widget_dot_cyan" />

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="TODAY FOCUS"
                android:textColor="#CBD5E1"
                android:textSize="9sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_streak_badge_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="🔥 14d"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <!-- 1-Tap Quick Add Shortcut Button -->
            <TextView
                android:id="@+id/widget_btn_add"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_add_btn_bg"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Empty View -->
    <LinearLayout
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ All blocks clear!"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap + to schedule next task"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Task Row 1: Active Focus Block (NOW Block with Progress Bar) -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_now_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginBottom="6dp"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/widget_content_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_check_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="8dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/widget_dot_cyan" />

            <TextView
                android:id="@+id/widget_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:layout_toEndOf="@id/widget_check_1"
                android:layout_toStartOf="@+id/widget_time_pill_1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DEEP WORK • SPRINT 03"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_time_pill_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_streak_badge_bg"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="09:00 - 11:30"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </RelativeLayout>

        <!-- Subtitle Row: Block Allocation & Remaining -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/widget_meta_1"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Block Allocation"
                android:textColor="#64748B"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_meta_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="42m remaining"
                android:textColor="#00F2FE"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Cyan Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/widget_progress_bar_cyan" />
    </LinearLayout>

    <!-- Task Row 2: Secondary Task (Green Dot) -->
    <RelativeLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:padding="8dp"
        android:layout_marginBottom="5dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/widget_check_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="8dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/widget_dot_green" />

        <LinearLayout
            android:id="@+id/widget_content_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/widget_check_2"
            android:layout_toStartOf="@+id/widget_meta_2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Q3 Design System Review"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_meta_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_streak_badge_bg"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="30m"
            android:textColor="#94A3B8"
            android:textSize="9.5sp" />
    </RelativeLayout>

    <!-- Task Row 3: Secondary Task (Violet Dot) -->
    <RelativeLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:padding="8dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/widget_check_3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:padding="8dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/widget_dot_violet" />

        <LinearLayout
            android:id="@+id/widget_content_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/widget_check_3"
            android:layout_toStartOf="@+id/widget_meta_3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sync w/ Engineering"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_meta_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_streak_badge_bg"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="15m"
            android:textColor="#94A3B8"
            android:textSize="9.5sp" />
    </RelativeLayout>

</LinearLayout>
