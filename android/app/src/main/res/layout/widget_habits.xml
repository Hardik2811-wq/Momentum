<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Routine Icon + ROUTINE MATRIX, 3/4 COMPLETED Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/habit_summary_badge"
            android:layout_marginEnd="6dp"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_routine_matrix" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:text="ROUTINE MATRIX"
                android:textColor="#CBD5E1"
                android:textSize="9sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/habit_summary_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_completed_badge_bg"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="3/4 DONE"
            android:fontFamily="sans-serif-medium"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Empty View -->
    <LinearLayout
        android:id="@+id/habit_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ All habits complete!"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to review streaks in app"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Habit Row 1 -->
    <RelativeLayout
        android:id="@+id/habit_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:padding="9dp"
        android:layout_marginBottom="5dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/habit_check_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_checkbox_checked"
            android:gravity="center"
            android:text="✓"
            android:textColor="#090B0E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/habit_check_1"
            android:layout_toStartOf="@+id/habit_streak_1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Morning Cold Exposure &amp; Breathwork"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_streak_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="🔥 42d"
            android:textColor="#CBD5E1"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Habit Row 2 -->
    <RelativeLayout
        android:id="@+id/habit_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:padding="9dp"
        android:layout_marginBottom="5dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/habit_check_2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_checkbox_checked"
            android:gravity="center"
            android:text="✓"
            android:textColor="#090B0E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/habit_check_2"
            android:layout_toStartOf="@+id/habit_streak_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Read 20 pages • Systems Architecture"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_streak_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="🔥 28d"
            android:textColor="#CBD5E1"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Habit Row 3 -->
    <RelativeLayout
        android:id="@+id/habit_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:padding="9dp"
        android:layout_marginBottom="5dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/habit_check_3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_checkbox_checked"
            android:gravity="center"
            android:text="✓"
            android:textColor="#090B0E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/habit_check_3"
            android:layout_toStartOf="@+id/habit_streak_3"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Zero Inbox &amp; Issue Triage"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habit_streak_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="🔥 21d"
            android:textColor="#CBD5E1"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Habit Row 4 -->
    <RelativeLayout
        android:id="@+id/habit_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:padding="9dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/habit_check_4"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_checkbox_bg"
            android:gravity="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/habit_title_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_toEndOf="@id/habit_check_4"
            android:layout_toStartOf="@+id/habit_streak_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Evening Kettlebell Mobility Protocol"
            android:fontFamily="sans-serif-medium"
            android:textColor="#8B95A5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/habit_streak_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="14d pending"
            android:textColor="#64748B"
            android:textSize="9.5sp" />
    </RelativeLayout>

</LinearLayout>
