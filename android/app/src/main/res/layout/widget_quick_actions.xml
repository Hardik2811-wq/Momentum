<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Task Column -->
    <LinearLayout
        android:id="@+id/btn_quick_add_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="TASK"
            android:textColor="#38BDF8"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_task"
            android:padding="7dp"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <!-- Goal Column -->
    <LinearLayout
        android:id="@+id/btn_quick_add_goal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/widget_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="GOAL"
            android:textColor="#C084FC"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_goal"
            android:padding="7dp"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <!-- Habit Column -->
    <LinearLayout
        android:id="@+id/btn_quick_add_habit"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_item_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="HABIT"
            android:textColor="#FBBF24"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_circle_habit"
            android:padding="7dp"
            android:src="@drawable/ic_add" />
    </LinearLayout>

</LinearLayout>
